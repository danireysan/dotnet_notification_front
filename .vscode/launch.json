{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "App Prod Debug",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "preLaunchTask": "prod_env",
            "args": [
                "--flavor", "prod_env"
            ],
            "program": "${workspaceFolder}/lib/main.dart"
        },
        {
            "name": "App Prod Profile",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "preLaunchTask": "prod_env",
            "args": [
                "--flavor", "prod_env"
            ],
            "program": "${workspaceFolder}/lib/main.dart"
        },
        {
            "name": "App Prod Release",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "preLaunchTask": "prod_env",
            "args": ["--flavor", "prod_env"],
            "program": "${workspaceFolder}/lib/main.dart"
        }
    ]
}
